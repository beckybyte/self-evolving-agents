# Leave CRUSOE_API_KEY empty to run the designer in offline mock mode.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Check exact IDs with GET /v1/models; casing differs between docs and API.
MODEL_DESIGNER=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_PLANNER=nvidia/Nemotron-3-Super-120B-A12B
MODEL_OBSERVER=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_ROUTER=nvidia/Nemotron-3-Nano-30B-A3B
DESIGNER_DRAFTS=3
DESIGNER_REPAIRS=2
