{
  "name": "evolve",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n agent,web -c yellow,cyan \"npm:dev:agent\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:agent": "tsx watch --env-file-if-exists=.env server/index.ts",
    "try-designer": "tsx scripts/try-designer.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@json-render/core": "^0.21.1",
    "@json-render/react": "^0.21.1",
    "ai": "^7.0.143",
    "express": "^5.3.0",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}